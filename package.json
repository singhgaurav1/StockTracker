{
  "name": "stock-tracker",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "esbuild web/app.js --bundle --format=esm --outfile=public/app.js",
    "dev": "npm run build:web && wrangler dev --ip 0.0.0.0 --port 5000",
    "deploy": "npm run build:web && wrangler deploy",
    "types": "wrangler types",
    "test": "node --experimental-strip-types --test test/*.test.ts test/*.test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.10",
    "wrangler": "^4.102.0"
  }
}
